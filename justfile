# Generated by setup-just
set shell := ["zsh", "-euo", "pipefail", "-c"]

# Run ast-grep tests
test:
    ast-grep test --skip-snapshot-tests --config sgconfig.yml

# Run ast-grep scan
scan:
    ast-grep scan --config sgconfig.yml

# Run security checks
sec:
    gitleaks detect --verbose
    bun audit

# Run biome checks
lint:
    biome check .

# Generate repomix bundle
pack:
    repomix

# Verify required tools are installed
tools:
    @command -v ast-grep >/dev/null 2>&1 || { echo "Missing required tool: ast-grep" >&2; exit 1; }
    @command -v repomix >/dev/null 2>&1 || { echo "Missing required tool: repomix" >&2; exit 1; }
    @command -v gitleaks >/dev/null 2>&1 || { echo "Missing required tool: gitleaks" >&2; exit 1; }
    @command -v bun >/dev/null 2>&1 || { echo "Missing required tool: bun" >&2; exit 1; }
    @command -v biome >/dev/null 2>&1 || { echo "Missing required tool: biome" >&2; exit 1; }

# Run check suite
check: tools test sec lint

# Verify tools then run check
verify: check

# Development server (override with just dev -- --port 3001)
dev *args:
    bun run dev {{args}}

# Production start
start *args:
    bun run start {{args}}

# Build
build *args:
    bun run build {{args}}

# Format + auto-fix
fix:
    biome check --write .

# Install dependencies
install:
    bun install

# Clean artifacts and caches
clean:
    rm -rf node_modules dist coverage .cache *.tsbuildinfo
    bun pm cache rm || true

# Full setup
setup: install

# Watch tests (if supported by your test runner)
test-watch *args:
    bun test {{args}} --hot

# Pre-commit style: fix then full check
pre: fix check

# Quick security + lint only
quick: sec lint

# Aliases
alias t := test
alias s := scan
alias l := lint
alias f := fix
alias c := check
alias d := dev
alias i := install
